# Шаблон /docker/hermes-agent/.env (права 600, владелец root).
# Значения со словом GENERATE генерируются прямо на сервере командами из CLAUDE.md,
# в чат их не вставлять и на экран не выводить.

# Вход в веб-интерфейс Гермеса. Пароль сохранить в Bitwarden.
ADMIN_USERNAME=hermes
ADMIN_PASSWORD=GENERATE

# Ключ подписи сессий веба. Без него при каждом перезапуске контейнера вход слетает;
# с ним вход живёт 30 дней.
DASHBOARD_AUTH_SECRET=GENERATE

# Имя сервера у Hostinger, вида srv1234567.hstgr.cloud (команда: hostname -f).
# Веб будет по адресу https://hermes-agent.<TRAEFIK_HOST>
TRAEFIK_HOST=srvXXXXXXX.hstgr.cloud

# Веб через Traefik: false — не опубликован вообще (вход только через SSH-туннель);
# true — опубликован, но пускает только из VPN_SOURCE_RANGE.
HERMES_WEB_VIA_VPN=false

# Откуда пускать в веб. Docker-сети этого сервера, в одной из которых сидит xray.
# Интернет в этот диапазон не попадает. Проверяется на фазе 6.
VPN_SOURCE_RANGE=172.16.0.0/12
